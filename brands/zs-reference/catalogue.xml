<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- The reference catalogue as applied by brands/zs-reference.yaml. It is
     deploy/compose/killbill/catalogue.xml with two more products. core-basic
     has the plan core-basic-monthly, with a 14-day trial and no usage.
     core-metered has the plan core-metered-monthly, with no trial and no
     recurring price, which bills the usage unit api-call at 0.01 per call in
     arrears, so forwarded usage shows on its first invoice. Its effective
     date is later than the bootstrap's, because Kill Bill rejects a second
     version with an effective date it already holds. -->
<catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="CatalogSchema.xsd">

    <effectiveDate>2026-10-19T00:00:00+00:00</effectiveDate>
    <catalogName>ZsReference</catalogName>

    <recurringBillingMode>IN_ADVANCE</recurringBillingMode>

    <currencies>
        <currency>CAD</currency>
        <currency>USD</currency>
    </currencies>

    <units>
        <unit name="api-call"/>
    </units>

    <products>
        <product name="core-test">
            <category>BASE</category>
        </product>
        <product name="core-basic">
            <category>BASE</category>
        </product>
        <product name="core-metered">
            <category>BASE</category>
        </product>
    </products>

    <rules>
        <changePolicy>
            <changePolicyCase>
                <policy>IMMEDIATE</policy>
            </changePolicyCase>
        </changePolicy>
        <changeAlignment>
            <changeAlignmentCase>
                <alignment>START_OF_BUNDLE</alignment>
            </changeAlignmentCase>
        </changeAlignment>
        <cancelPolicy>
            <cancelPolicyCase>
                <policy>IMMEDIATE</policy>
            </cancelPolicyCase>
        </cancelPolicy>
        <createAlignment>
            <createAlignmentCase>
                <alignment>START_OF_BUNDLE</alignment>
            </createAlignmentCase>
        </createAlignment>
        <billingAlignment>
            <billingAlignmentCase>
                <alignment>ACCOUNT</alignment>
            </billingAlignmentCase>
        </billingAlignment>
        <priceList>
            <priceListCase>
                <toPriceList>DEFAULT</toPriceList>
            </priceListCase>
        </priceList>
    </rules>

    <plans>
        <plan name="core-test-monthly">
            <product>core-test</product>
            <initialPhases>
                <phase type="TRIAL">
                    <duration>
                        <unit>DAYS</unit>
                        <number>14</number>
                    </duration>
                    <fixed type="ONE_TIME">
                        <fixedPrice>
                            <price>
                                <currency>CAD</currency>
                                <value>0.00</value>
                            </price>
                            <price>
                                <currency>USD</currency>
                                <value>0.00</value>
                            </price>
                        </fixedPrice>
                    </fixed>
                </phase>
            </initialPhases>
            <finalPhase type="EVERGREEN">
                <duration>
                    <unit>UNLIMITED</unit>
                </duration>
                <recurring>
                    <billingPeriod>MONTHLY</billingPeriod>
                    <recurringPrice>
                        <price>
                            <currency>CAD</currency>
                            <value>10.00</value>
                        </price>
                        <price>
                            <currency>USD</currency>
                            <value>8.00</value>
                        </price>
                    </recurringPrice>
                </recurring>
                <usages>
                    <usage name="core-test-monthly-api-call" billingMode="IN_ARREAR" usageType="CONSUMABLE">
                        <billingPeriod>MONTHLY</billingPeriod>
                        <tiers>
                            <tier>
                                <blocks>
                                    <tieredBlock>
                                        <unit>api-call</unit>
                                        <size>1000</size>
                                        <prices>
                                            <price>
                                                <currency>CAD</currency>
                                                <value>1.00</value>
                                            </price>
                                            <price>
                                                <currency>USD</currency>
                                                <value>0.80</value>
                                            </price>
                                        </prices>
                                        <max>1000000</max>
                                    </tieredBlock>
                                </blocks>
                            </tier>
                        </tiers>
                    </usage>
                </usages>
            </finalPhase>
        </plan>
        <plan name="core-basic-monthly">
            <product>core-basic</product>
            <initialPhases>
                <phase type="TRIAL">
                    <duration>
                        <unit>DAYS</unit>
                        <number>14</number>
                    </duration>
                    <fixed type="ONE_TIME">
                        <fixedPrice>
                            <price>
                                <currency>CAD</currency>
                                <value>0.00</value>
                            </price>
                            <price>
                                <currency>USD</currency>
                                <value>0.00</value>
                            </price>
                        </fixedPrice>
                    </fixed>
                </phase>
            </initialPhases>
            <finalPhase type="EVERGREEN">
                <duration>
                    <unit>UNLIMITED</unit>
                </duration>
                <recurring>
                    <billingPeriod>MONTHLY</billingPeriod>
                    <recurringPrice>
                        <price>
                            <currency>CAD</currency>
                            <value>5.00</value>
                        </price>
                        <price>
                            <currency>USD</currency>
                            <value>4.00</value>
                        </price>
                    </recurringPrice>
                </recurring>
            </finalPhase>
        </plan>
        <plan name="core-metered-monthly">
            <product>core-metered</product>
            <finalPhase type="EVERGREEN">
                <duration>
                    <unit>UNLIMITED</unit>
                </duration>
                <usages>
                    <usage name="core-metered-monthly-api-call" billingMode="IN_ARREAR" usageType="CONSUMABLE">
                        <billingPeriod>MONTHLY</billingPeriod>
                        <tiers>
                            <tier>
                                <blocks>
                                    <tieredBlock>
                                        <unit>api-call</unit>
                                        <size>1</size>
                                        <prices>
                                            <price>
                                                <currency>CAD</currency>
                                                <value>0.01</value>
                                            </price>
                                            <price>
                                                <currency>USD</currency>
                                                <value>0.01</value>
                                            </price>
                                        </prices>
                                        <max>100000000</max>
                                    </tieredBlock>
                                </blocks>
                            </tier>
                        </tiers>
                    </usage>
                </usages>
            </finalPhase>
        </plan>
    </plans>

    <priceLists>
        <defaultPriceList name="DEFAULT">
            <plans>
                <plan>core-test-monthly</plan>
                <plan>core-basic-monthly</plan>
                <plan>core-metered-monthly</plan>
            </plans>
        </defaultPriceList>
    </priceLists>
</catalog>
