# ZSoftly Core configuration. Every variable is documented in
# docs/configuration.md. Only ZS_DATABASE_URL is required; the other values
# shown are the defaults.

ZS_DATABASE_URL=postgres://zs:change-me@127.0.0.1:5432/zs_core?sslmode=disable
ZS_DATABASE_MAX_CONNS=10
ZS_LISTEN_ADDR=127.0.0.1:8080
ZS_LOG_LEVEL=info
ZS_LOG_FORMAT=json
ZS_MIGRATE_ON_START=true
ZS_HTTP_READ_HEADER_TIMEOUT=5s
ZS_HTTP_READ_TIMEOUT=30s
ZS_HTTP_WRITE_TIMEOUT=30s
ZS_HTTP_IDLE_TIMEOUT=120s
ZS_SHUTDOWN_TIMEOUT=15s

# Component settings, read by `zs-core doctor`. All optional. An admin user
# and its password are set together or not at all. Without admin credentials
# doctor cannot read the Keycloak or Kill Bill version and reports a warning.
# ZS_KEYCLOAK_URL=http://127.0.0.1:8180
# ZS_KEYCLOAK_REALM=zs-reference
# ZS_KEYCLOAK_ADMIN_USER=admin
# ZS_KEYCLOAK_ADMIN_PASSWORD=
# ZS_KILLBILL_URL=http://127.0.0.1:8081
# ZS_KILLBILL_ADMIN_USER=admin
# ZS_KILLBILL_ADMIN_PASSWORD=
# ZS_KAUI_URL=http://127.0.0.1:9090

# Development only. Accepts X-ZS-Brand and X-ZS-Tenant without
# authentication. Refused unless ZS_LISTEN_ADDR is a loopback address.
ZS_DEV_TRUSTED_SCOPE_HEADERS=false

# Test suite only; the service ignores ZS_TEST_ variables. When set,
# integration tests use this server instead of a Docker container. It must
# point at a loopback host.
# ZS_TEST_POSTGRES_URL=postgres://zs:zs-test@127.0.0.1:55432/zs_core_test?sslmode=disable
