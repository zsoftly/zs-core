# ZSoftly Core configuration. Every variable is documented in
# docs/configuration.md. ZS_DATABASE_URL is required. serve also needs
# ZS_KEYCLOAK_URL to verify tokens. Other uncommented values are defaults.

ZS_DATABASE_URL=postgres://zs:change-me@127.0.0.1:5432/zs_core?sslmode=disable
ZS_DATABASE_MAX_CONNS=10
ZS_LISTEN_ADDR=127.0.0.1:8080
ZS_LOG_LEVEL=info
ZS_LOG_FORMAT=json
ZS_MIGRATE_ON_START=true
ZS_HTTP_READ_HEADER_TIMEOUT=5s
ZS_HTTP_READ_TIMEOUT=30s
ZS_HTTP_WRITE_TIMEOUT=30s
ZS_HTTP_IDLE_TIMEOUT=120s
ZS_SHUTDOWN_TIMEOUT=15s
# How often serve completes interrupted tenant creations and corrects Keycloak
# Organizations towards Core.
ZS_TENANT_SWEEP_INTERVAL=1m
# How often serve reverses the unused part of expired credits Core issued.
ZS_CREDIT_SWEEP_INTERVAL=1h
# How often serve expires reservations past their lease, completes the
# settlements that wait for Kill Bill and reconciles the wallet view with
# Kill Bill.
ZS_WALLET_SWEEP_INTERVAL=1m
# How often serve forwards recorded usage to Kill Bill as usage records.
ZS_METERING_FORWARD_INTERVAL=1m
# How long a reservation relies on the Kill Bill credit it last read. At
# most 1m.
ZS_WALLET_CREDIT_CACHE_TTL=5s
# How often serve releases concurrent quota leases past their expiry.
ZS_QUOTA_SWEEP_INTERVAL=1m
# How often serve makes sure the usage event partitions of this month and
# the next three exist. Runs with or without Kill Bill.
ZS_USAGE_PARTITION_INTERVAL=1h

# Keycloak as the service reaches it. serve reads each brand realm's issuer
# and signing keys from here.
ZS_KEYCLOAK_URL=http://127.0.0.1:8180

# Admin settings, used by brand apply, brand diff and doctor. Optional for
# serve. An admin user and its password are set together or not at all.
# ZS_KEYCLOAK_REALM=zs-reference
# ZS_KEYCLOAK_ADMIN_USER=admin
# ZS_KEYCLOAK_ADMIN_PASSWORD=
# Optional instead of the admin user: a master-realm client with the
# client credentials grant. Set both or neither.
# ZS_KEYCLOAK_ADMIN_CLIENT_ID=
# ZS_KEYCLOAK_ADMIN_CLIENT_SECRET=
# ZS_KILLBILL_URL=http://127.0.0.1:8081
# ZS_KILLBILL_ADMIN_USER=admin
# ZS_KILLBILL_ADMIN_PASSWORD=
# ZS_KAUI_URL=http://127.0.0.1:9090

# Kill Bill push notifications and billing credentials. The secret is at
# least 32 characters. The callback URL is Core as Kill Bill reaches it.
# With both set, brand apply registers each brand's callback.
# ZS_KILLBILL_WEBHOOK_SECRET=
# ZS_KILLBILL_CALLBACK_URL=http://127.0.0.1:8080

# Brand manifests, <slug>.yaml. serve validates them at start. Apply stays
# explicit: run zs-core brand apply.
# ZS_BRANDS_DIR=./brands

# File secrets of brand manifests, one directory per brand slug. A
# file:// reference of brand <slug> must resolve inside ZS_SECRETS_DIR/<slug>/.
# Unset, file:// references are refused.
# ZS_SECRETS_DIR=/run/zs-core/secrets

# Deployment steps only: zs-core plugin ddl apply, doctor and brand apply on
# the command line read the Kill Bill database. serve never does.
# ZS_KILLBILL_DATABASE_URL=postgres://killbill:change-me@127.0.0.1:5432/killbill?sslmode=disable

# The PDF renderer for invoice PDFs. Unset, invoice PDFs answer 404.
# ZS_PDF_RENDERER_URL=http://127.0.0.1:3000

# The plugin mirror: zs-core plugin mirror sync fills the directory, serve
# serves it behind the secret (at least 32 characters). New plugin installs
# require the URL and secret in the brand apply process; the URL must reach
# Core from Kill Bill. KPM never falls back to the repository. Starting an
# already-installed plugin needs no jar download.
# ZS_PLUGIN_MIRROR_DIR=/var/lib/zs-core/plugins
# ZS_PLUGIN_MIRROR_SECRET=
# ZS_PLUGIN_MIRROR_URL=http://127.0.0.1:8080

# Secrets that brand manifests reference with env://NAME are not ZS_
# variables. Each brand's names start with BRAND_<SLUG>__: the slug in upper
# case with - replaced by _, then two underscores.
# brands/zs-reference.yaml references these two:
# BRAND_ZS_REFERENCE__KEYCLOAK_STAFF_CLIENT_SECRET=
# BRAND_ZS_REFERENCE__KILLBILL_TENANT_API_SECRET=

# Test suite only; the service ignores ZS_TEST_ variables. When set,
# integration tests use this server instead of a Docker container. It must
# point at a loopback host.
# ZS_TEST_POSTGRES_URL=postgres://zs:zs-test@127.0.0.1:55432/zs_core_test?sslmode=disable
