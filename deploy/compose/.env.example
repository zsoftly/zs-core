# Reference stack settings. Copy to .env (make stack-up does this for you).
# Every value below is a development placeholder. The stack binds to
# 127.0.0.1 on the host that runs it; do not reuse these values anywhere else.

# Image overrides. Unset, compose.yaml uses the digest pins of components.yaml.
# Set one only to rehearse an upgrade (see docs/upgrades), and unset it
# afterwards. An override may name a plain tag, as below, or image@sha256:...
# KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1
# KILLBILL_IMAGE=killbill/killbill:0.24.22
# KAUI_IMAGE=killbill/kaui:4.0.31
# POSTGRES_IMAGE=postgres:18-alpine
# MAILPIT_IMAGE=axllent/mailpit:v1.26.2
# GOTENBERG_IMAGE=gotenberg/gotenberg:8.38.1

# Database passwords (one role per database).
POSTGRES_PASSWORD=change-me-postgres
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KILLBILL_DB_PASSWORD=change-me-killbill-db
KAUI_DB_PASSWORD=change-me-kaui-db
ZS_CORE_DB_PASSWORD=change-me-core-db

# Keycloak bootstrap administrator and the secret of the zs-staff client.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
ZS_STAFF_CLIENT_SECRET=change-me-staff-client-secret
# brands/zs-reference.yaml references its secrets in the BRAND_ZS_REFERENCE__
# namespace: env://BRAND_ZS_REFERENCE__KEYCLOAK_STAFF_CLIENT_SECRET holds this
# value and env://BRAND_ZS_REFERENCE__KILLBILL_TENANT_API_SECRET holds
# KILLBILL_TENANT_API_SECRET below. Before zs-core brand apply, run:
# export BRAND_ZS_REFERENCE__KEYCLOAK_STAFF_CLIENT_SECRET="$ZS_STAFF_CLIENT_SECRET"
# export BRAND_ZS_REFERENCE__KILLBILL_TENANT_API_SECRET="$KILLBILL_TENANT_API_SECRET"

# Kill Bill: password of the built-in admin user, and the credentials of the
# zs-reference tenant that bootstrap.sh creates.
KILLBILL_ADMIN_PASSWORD=change-me-killbill-admin
KILLBILL_TENANT_API_KEY=zs-reference
KILLBILL_TENANT_API_SECRET=change-me-tenant-secret

# Verifies Kill Bill push notifications to Core and signs billing
# credentials. At least 32 characters.
ZS_KILLBILL_WEBHOOK_SECRET=change-me-killbill-webhook-secret-0123456789

# Protects Core's plugin mirror and signs its manifest. At least 32
# characters. Kill Bill downloads plugin jars from Core with a token derived
# from it.
ZS_PLUGIN_MIRROR_SECRET=change-me-plugin-mirror-secret-0123456789
# Core's base URL as Kill Bill reaches the mirror. New plugin installs
# require this URL and ZS_PLUGIN_MIRROR_SECRET, with no repository fallback.
# compose.yaml supplies http://core:8080 when this override is unset.
# ZS_PLUGIN_MIRROR_URL=http://core:8080

# KAUI session secret. Any long random string.
KAUI_SECRET_KEY_BASE=change-me-kaui-secret-key-base-at-least-64-characters-long-0123456789

# Host ports. All bind to 127.0.0.1.
# POSTGRES_HOST_PORT=5432
# KEYCLOAK_HOST_PORT=8180
# KEYCLOAK_MANAGEMENT_HOST_PORT=9000
# KILLBILL_HOST_PORT=8081
# KAUI_HOST_PORT=9090
# MAILPIT_UI_HOST_PORT=8025
# MAILPIT_SMTP_HOST_PORT=1025
# CORE_HOST_PORT=8080
# GOTENBERG_HOST_PORT=3000
